      var cat = it[0], name = it[1], icon = it[2], desc = it[3];
      var p1 = it[4], p2 = it[5], url = it[6], type = it[7], access = it[8];
      var section = catMap[cat];
      if (!section) {
        var m = catMeta[cat] || {l:cat, e:'📌'};
        section = document.createElement('section');
