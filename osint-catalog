      { value: 'company', label: '🏢 Компании и бизнес' },
      { value: 'maps', label: '🗺️ Карты и спутники' },
      { value: 'media', label: '📰 Медиа и документы' },
      { value: 'ai', label: '🤖 AI-инструменты' }
    ],
    sort: [
      { value: 'popular', label: 'По популярности' },
      { value: 'name', label: 'По названию (А-Я)' },
      { value: 'name-desc', label: 'По названию (Я-А)' }
    ],
    type: [
      { value: 'all', label: 'Все типы' },
      { value: 'web', label: 'Веб-сервис' },
      { value: 'cli', label: 'CLI / утилита' },
      { value: 'api', label: 'API' }
    ],
    access: [
      { value: 'any', label: 'Любой' },
      { value: 'free', label: 'Бесплатно' },
      { value: 'freemium', label: 'Freemium' },
      { value: 'paid', label: 'Платно' }
    ]
  };

  var state = { category:'all', sort:'popular', type:'all', access:'any', query:'', favoritesOnly:false, view:'list' };

  var searchInput = document.getElementById('search');
  var shownCount  = document.getElementById('shownCount');
  var totalCount  = document.getElementById('totalCount');
  var favBtn      = document.getElementById('favBtn');
  var emptyEl     = document.getElementById('empty');

  var allCards, allCategories;
  function refreshNodes() {
    allCards = Array.prototype.slice.call(document.querySelectorAll('.card'));
    allCategories = Array.prototype.slice.call    allCards.forEach(function(card, i){
      if (!card.dataset.popularity) card.dataset.popularity = String(allCards.length - i);
      if (!card.dataset.favInit) {
        card.dataset.favInit = '1';
        var head = card.querySelector('.card-head');
        if (head && !head.querySelector('.card-fav')) {
          var btn = document.createElement('button');
          btn.className = 'card-fav';
          btn.setAttribute('title', 'В избранное');
          btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
          function refreshFav(){
            var isFav = card.dataset.fav === '1';
            btn.classList.toggle('active', isFav);
            btn.querySelector('svg').setAttribute('fill', isFav ? 'currentColor' : 'none');
          }
          refreshFav();
          btn.addEventListener('click', function(e){
            e.stopPropagation();
            card.dataset.fav = card.dataset.fav === '1' ? '0' : '1';
            refreshFav();
            if (state.favoritesOnly) applyFilters();
          });
          head.appendChild(btn);
        }
        card.addEventListener('click', function(e){
          if (e.target.closest('.card-link') || e.target.closest('.card-fav')) return;
          var link = card.querySelector('.card-link');
          if (link) window.open(link.href, '_blank');
        });
      }
    });
  }

  function buildDropdown(selectEl, key) {
    var items = FILTERS[key];
    var valueEl = selectEl.querySelector('.value');
    var menu = document.createElement('div');
    menu.className = 'dropdown-menu';
    function renderMenu() {
      menu.innerHTML = '';
      items.forEach(function(item){
        var opt = document.createElement('div');
        opt.className = 'opt' + (item.value === state[key] ? ' selected' : '');
        opt.textContent = item.label;
        opt.addEventListener('click', function(e){
          e.stopPropagation();
          state[key] = item.value;
          valueEl.textContent = item.label;
          closeAllMenus();
          applyFilters();
        });
        menu.appendChild(opt);
      });
    }
    function updateValueText() {
      var cur = items.filter btn(function(i){ return i.value === state[key]; })[0.addEventListener];
      if (cur) valueEl.text('Content = cur.label;
    }
    selectElclick.appendChild(menu);
    updateValueText();
    select',El.addEventListener(' functionclick', function(e){
      e.stopPropagation();
      var isOpen = menu.classList.contains('show');
      closeAllMenus();
      if (!isOpen) { renderMenu(); menu.classList.add('show'); selectEl.classList.add('open'); }
    });
    selectEl._updateValue = updateValueText;
  }

  function closeAllMenus() {
    document.querySelectorAll('.dropdown-menu.show').forEach(function(m){
      m.classList.remove('show');
      if (m.parentElement) m.parentElement.classList.remove('open');
    });
  }

  document.querySelectorAll('.filters .select').forEach(function(el){ buildDropdown(el, el.dataset.filter); });
  document.addEventListener('click', closeAllMenus);

  function applyFilters() {
    var visible = 0;
    allCards.forEach(function(card){
      var cat = card.closest('.category');
      var catKey = cat ? cat.dataset.category : 'other';
      var text = card.textContent.toLowerCase();
      var okQuery    = !state.query || text.indexOf(state.query) !== -1;
      var okCategory = state.category === 'all' || catKey === state.category;
      var okType     = state.type === 'all' || card.dataset.type === state.type;
      var okAccess   = state.access === 'any' || card.dataset.access === state.access;
      var okFav      = !state.favoritesOnly || card.dataset.fav === '1';
      var show = okQuery && okCategory && okType && okAccess && okFav;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    allCategories.forEach(function(cat){
      var vis = 0;
      cat.querySelectorAll('.card').forEach(function(c){ if (c.style.display !== 'none') vis++; });
      cat.style.display = vis ? '' : 'none';
      var counter = cat.querySelector('.count');
      if (counter) counter.textContent = vis;
    });
    shownCount.textContent = visible;
    totalCount.textContent = '/ ' + allCards.length;
    var catSelect = document.querySelector('.filters .select[data-filter="category"]');
    if (catSelect && catSelect._updateValue && state.category !== 'all') catSelect._updateValue();
    emptyEl.classList.toggle('show', visible === 0);
    sortCards();
  }

  function sortCards() {
    allCategories.forEach(function(cat){
      var body = cat.querySelector('.cat-body');
      if (!body) return;
      var cards = Array.prototype.slice.call(body.querySelectorAll('.card'));
      cards.sort(function(a, b){
        var na = (a.querySelector('.card-name') || {}).textContent || '';
        var nb = (b.querySelector('.card-name') || {}).textContent || '';
        if (state.sort === 'name')      return na.localeCompare(nb, 'ru');
        if (state.sort === 'name-desc') return nb.localeCompare(na, 'ru');
        return Number(b.dataset.popularity || 0) - Number(a.dataset.popularity || 0);
      });
      cards.forEach(function(c){ body.appendChild(c); });
    });
  }

  searchInput.addEventListener('input', function(e){
    state.query = e.target.value.toLowerCase().trim();
    applyFilters();
  });

  favBtn.addEventListener('click', function(){
    state.favoritesOnly = !state.favoritesOnly;
    favBtn.classList.toggle('active', state.favoritesOnly);
    applyFilters();
  });

  function applyView() {
    allCategories.forEach(function(cat){
      var body = cat.querySelector('.cat-body');
      if (!body) return;
      body.classList.remove('view-grid', 'view-compact', 'view-tree');
      if (state.view !== 'list') body.classList.add('view-' + state.view);
    });
  }

  document.querySelectorAll('.view-switch button').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.view-switch button').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      state.view = btn.dataset.view;
      applyView();
    });
  });

  document.querySelectorAll('.category').forEach(function(cat){
    var header = cat.querySelector('.cat-header');
    if (!header) return;
    header.addEventListener('click', function(){
      cat.classList.toggle('collapsed');
      var t = header.querySelector('.cat-toggle').childNodes[0];
      if (t && t.nodeValue) t.nodeValue = cat.classList.contains('collapsed') ? 'раскрыть ' : 'свернуть ';
    });
  });

  document.querySelectorAll('.lang-switch button').forEach(function(btn){
   (){
      document.querySelectorAll('.lang-switch button').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
    });
  });

  refreshNodes();
  applyFilters();
  applyView();
})();
