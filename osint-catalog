        section.innerHTML = '<div class="cat-header"><h2>'+m.l+' <span class="count">0</span></h2><div class="cat-toggle">свернуть<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></div></div><div class="cat-body"></div>';
        mainEl.insertBefore(section, mainEl.querySelector('.empty'));
        catMap[cat] = section;
      }
      var body = section.querySelector('.cat-body');
      var card = document.createElement('div');
      card.className = 'card';
      card.dataset.type = type;
      card.dataset.access = access;
      card.innerHTML = '<div class="card-head"><div class="card-title"><div class="card-icon">'+icon+'</div><div class="card-name">'+name+'</div></div></div><div class="card-desc">'+desc+'</div><div class="card-footer"><div class="card-path">'+p1+' / <span>'+p2+'</span></div><a class="card-link" href="'+url+'" target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a></div>';
